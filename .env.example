# ==========================================================
# 골든타임 세이프맵 환경변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성하고 실제 키 값을 입력하세요.
# ==========================================================

# 1. Google Maps Platform API Key (Google Cloud Console에서 발급)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. 공공데이터포털 전국 AED 정보조회 서비스 인증키
DATA_GO_KR_KEY=your_data_go_kr_service_key_here

# 3. 서버 포트 설정
PORT=3000

# 4. 데이터베이스 연결 정보 (선택 사항)
# DATABASE_URL=postgresql://user:password@localhost:5432/safemap
# DB_PASSWORD=your_db_password_here
