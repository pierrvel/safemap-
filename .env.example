# ==========================================================
# 골든타임 세이프맵 환경변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성하고 실제 키 값을 입력하세요.
# ==========================================================

# 1. 카카오맵 JavaScript API Key (Kakao Developers 콘솔에서 발급)
KAKAO_MAP_API_KEY=your_kakao_javascript_key_here

# 1-1. 카카오 REST API Key (주소 및 키워드 지오코딩 검증용, 선택사항 - 미지정 시 JS 키 폴백)
KAKAO_REST_API_KEY=your_kakao_rest_key_here

# 2. 공공데이터포털 전국 AED 정보조회 서비스 인증키
DATA_GO_KR_KEY=your_data_go_kr_service_key_here

# 3. 서버 포트 설정
PORT=3000
